{
  "name": "pepkio-distrogene-probability-calculator",
  "version": "0.1.0",
  "description": "Calculate CRISPR coverage, GO enrichment, variant detection, and barcode collision probabilities with reverse sizing and publication Methods text export via the Pepkio REST API.",
  "readme": "README_NPM.md",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-distrogene-probability-calculator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-distrogene-probability-calculator-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-distrogene-probability-calculator-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/distrogene-probability-calculator",
  "keywords": [
    "distrogene-probability-calculator",
    "crispr-coverage",
    "go-enrichment",
    "variant-detection",
    "barcode-collision",
    "genomics",
    "probability",
    "statistics",
    "poisson",
    "hypergeometric",
    "binomial",
    "pepkio",
    "laboratory-tools",
    "life-sciences",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  }
}
